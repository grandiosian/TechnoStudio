   "synthese": "S",
   "evaluation": "E"
  },
  "types_champs": {
   "text": "contenu",
   "image": "contenu",
   "svg": "contenu",
   "scan": "contenu",
   "link": "contenu",
   "ressource": "contenu",
   "mots": "contenu",
   "objectif": "structure",
   "retenir": "structure",
   "decoupe": "structure",
   "filet": "structure",
   "qcm": "exercice, noté",
   "vraifaux": "exercice, noté",
   "cloze": "exercice, noté",
   "numeric": "exercice, noté",
   "match": "exercice, noté",
   "order": "exercice, noté",
   "sort": "exercice, noté",
   "table": "exercice, noté",
   "boxes": "exercice, noté",
   "chain": "exercice, noté",
   "label": "exercice, noté",
   "bits": "exercice, noté",
   "graph": "exercice, noté",
   "draw": "exercice, noté, à corriger",
   "mindmap": "exercice, noté",
   "procedure": "exercice, noté",
   "questions": "exercice, noté, à corriger",
   "report": "exercice, noté, à corriger",
   "autoeval": "exercice",
   "circuit": "simulation, noté",
   "blocks": "simulation, noté",
   "code": "simulation, noté, à corriger"
  },
  "cartes": [
   "uno",
   "nano",
   "esp32",
   "esp32-mpy",
   "microbit"
  ]
 },
 "$defs": {
  "Atelier": {
   "type": "object",
   "properties": {
    "format": {
     "type": "number",
     "enum": [
      1,
      2
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9-]+$"
    },
    "version": {
     "type": "number",
     "minimum": 1
    },
    "title": {
     "type": "string"
    },
    "level": {
     "type": "string",
     "enum": [
      "college",
      "sti2d",
      "snt",
      "pro"
     ]
    },
    "niveau": {
     "type": "string",
     "description": "5e, 4e, 3e… (couleur de pastille)"
    },
    "cycle": {
     "type": "number"
    },
    "seq": {
     "type": "number",
     "description": "numéro « AT SEQ »"
    },
    "duration": {
     "type": "number"
    },
    "author": {
     "type": "string"
    },
    "summary": {
     "type": "string"
    },
    "problematique": {
     "type": "string"
    },
    "objet": {
     "type": "string"
    },
    "position": {
     "type": "number",
     "minimum": 0,
     "maximum": 9
    },
    "competences": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "object",
        "properties": {
         "code": {
          "type": "string",
          "pattern": "^T\\d"
         },
         "label": {
          "type": "string"
         },
         "color": {
          "type": "string"
         },
         "co": {
          "type": "string"
         },
         "sub": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "code": {
             "type": "string"
            },
            "label": {
             "type": "string"
            }
           },
           "required": [
            "code",
            "label"
           ]
          }
         }
        },
        "required": [
         "label"
        ]
       }
      ]
     }
    },
    "presentation": {
     "type": "string",
     "format": "markdown"
    },
    "synthese": {
     "type": "string",
     "format": "markdown"
    },
    "evaluation": {
     "type": "string",
     "format": "markdown"
    },
    "differenciation": {
     "type": "string",
     "format": "markdown"
    },
    "materiel": {
     "type": "string",
     "format": "markdown"
    },
    "deroulement": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "seance": {
        "type": "string"
       },
       "objectif": {
        "type": "string"
       },
       "activites": {
        "type": "string"
       },
       "ressources": {
        "type": "string"
       }
      }
     }
    },
    "prof": {
     "type": "object",
     "properties": {
      "organisation": {
       "type": "string",
       "format": "markdown"
      },
      "materiel": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "seance": {
          "type": "string"
         },
         "contenu": {
          "type": "string"
         }
        }
       }
      }
     },
     "description": "fiche professeur, jamais transmise aux élèves"
    },
    "steps": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Feuille"
     }
    },
    "updatedAt": {
     "type": "number"
    }
   },
   "required": [
    "id",
    "title",
    "steps"
   ]
  },
  "Feuille": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "feuille",
      "ressource",
      "synthese",
      "evaluation"
     ],
     "description": "Type de feuille de la charte : P, R, S, E."
    },
    "seance": {
     "type": "number",
     "minimum": 1
    },
    "feuille": {
     "type": "number",
     "minimum": 1
    },
    "segpa": {
     "type": "boolean"
    },
    "verso": {
     "type": "boolean"
    },
    "big": {
     "type": "boolean"
    },
    "resume": {
     "type": "string"
    },
    "objectif": {
     "type": "string"
    },
    "consignes": {
     "type": "string"
    },
    "numStart": {
     "type": "number"
    },
    "blocks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Champ"
     }
    }
   },
   "required": [
    "title",
    "blocks"
   ]
  },
  "Reponse": {
   "type": "object",
   "properties": {
    "value": {},
    "done": {
     "type": "boolean"
    },
